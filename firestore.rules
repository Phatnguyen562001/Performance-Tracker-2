rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every signed-in user gets their own private branch of the database at
    // /users/{their-uid}/... — Google Sign-In guarantees request.auth.uid is
    // the caller's real, verified account ID, so this single rule is enough
    // to make sure nobody can ever read or write another user's data.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Read-only share links. Anyone who knows the long random link id can
    // read that ONE document (get), but nobody can list/browse them. Only the
    // owner can create, change or delete it.
    match /shares/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
