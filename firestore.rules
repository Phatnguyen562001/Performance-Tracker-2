rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every signed-in user gets their own private branch of the database at
    // /users/{their-uid}/... — Google Sign-In guarantees request.auth.uid is
    // the caller's real, verified account ID, so this single rule is enough
    // to make sure nobody can ever read or write another user's data.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Read-only share links. Anyone who knows the long random link id can
    // read that ONE document (get), but nobody can list/browse them. Only the
    // owner can create, change or delete it.
    match /shares/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      // Notes/recommendations left by people who opened the link. Anyone with
      // the link can ADD one (size-limited); only the owner can read/delete.
      match /comments/{cid} {
        allow create: if exists(/databases/$(database)/documents/shares/$(token))
          && request.resource.data.keys().hasOnly(['author', 'kind', 'text', 'taskId', 'taskTitle', 'createdAt'])
          && request.resource.data.keys().hasAll(['kind', 'text', 'createdAt'])
          && request.resource.data.kind in ['Note', 'Recommendation', 'Question']
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.author is string
          && request.resource.data.author.size() <= 80
          && request.resource.data.taskId is string
          && request.resource.data.taskTitle is string
          && request.resource.data.createdAt is number;
        allow read, delete: if request.auth != null
          && get(/databases/$(database)/documents/shares/$(token)).data.ownerUid == request.auth.uid;
        allow update: if false;
      }
    }
  }
}
